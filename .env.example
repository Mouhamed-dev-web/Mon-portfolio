# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# Boîte qui REÇOIT les messages du formulaire (ton email)
CONTACT_TO_EMAIL=ton.email@gmail.com

# Compte qui ENVOIE (peut être le même Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton.email@gmail.com
# Gmail : mot de passe d'application (pas ton mot de passe normal)
SMTP_PASS=xxxx xxxx xxxx xxxx
